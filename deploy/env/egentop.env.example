# Egentop — production environment template (validation instance).
#
# Install:
#   sudo install -d /etc/egentop -o root -g egentop -m 750
#   sudo install -m 0640 deploy/env/egentop.env.example /etc/egentop/egentop.env
#   sudo chown root:egentop /etc/egentop/egentop.env
# then fill in the real values. No secrets are committed to the repo; this
# file is only a template.
#
# This template lists ONLY the variables the application actually reads
# (verified against pkg/config/config.go). See the "Documented but not read"
# block at the bottom for vars that appear in the README but are ignored by
# the running binary — do not expect them to take effect.

# Runtime mode. `production` makes the refresh-token cookie carry the `Secure`
# flag, so the app MUST be served over HTTPS (the nginx proxy handles this).
APP_ENV=production

# HTTP listen port (the app binds :PORT on all interfaces inside its sandbox).
# Never expose this port publicly — the nginx proxy on 443 is the only public
# entry point. With Docker, publish to the host loopback only
# (-p 127.0.0.1:8080:8080); with the bare binary, firewall 8080 or bind
# loopback at the network layer.
APP_PORT=8080

# PostgreSQL connection URL. Required.
#   - Compose path (deploy/docker/egentop-compose.prod.yaml): use the service
#     name — postgres://egentop:PASSWORD@postgres:5432/egentop — and
#     sslmode=disable (traffic never leaves the host).
#   - Bare-binary/systemd path with host Postgres: use 127.0.0.1 and
#     sslmode=disable (loopback).
#   - Remote/managed Postgres: use the provider host, sslmode=require, and an
#     IP allowlist. Never expose the database port publicly.
# Password special characters must be percent-encoded (RFC 3986).
DB_URL=postgres://egentop:REPLACE_ME@postgres:5432/egentop?sslmode=disable

# JWT signing secret. Required, >= 32 characters, cryptographically random.
# Generate with:
#   openssl rand -base64 48
# Store it only in this file (and your secret manager). Rotate by changing
# the value and restarting the app (sessions are server-side, so existing
# refresh tokens survive a rotation).
JWT_SECRET=REPLACE_WITH_openssl_rand_-base64_48_output

# Token lifetimes (Go duration strings).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Comma-separated CORS allowlist. Must be the REAL origin(s) of the client
# app (no wildcards). Example: https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Log level threshold. One of debug, info, warn, error (unknown -> info).
# debug and info keep Info/Warn/Error; warn drops Info; error drops Info+Warn.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Documented but NOT read by the running application (config surface verified
# 2026-08-14 against pkg/config/config.go):
#   - APP_NAME             (no code reads it)
#   - DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD/DB_SSLMODE
#                           (used only by Makefile targets to build a local DSN;
#                           the app itself reads DB_URL only)
# ---------------------------------------------------------------------------
