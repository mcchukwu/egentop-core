APP_PORT=8080
APP_ENV=development

# Makefile-only: the Makefile targets (migrate-up, migrate-down,
# authz-decisions-cleanup) read these from .env to build a local DSN.
# The running app reads DB_URL only.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=egentop
DB_USER=user
DB_PASSWORD=password
DB_SSLMODE=disable

DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

LOG_LEVEL=debug

# General per-IP API rate limit (requests/minute); floor is 20 — lower
# values are rejected at startup. Raise for local dev/manual testing (e.g.
# 600) since all dev requests share one IP; keep the production default.
RATE_LIMIT_GENERAL_PER_MIN=100

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars

# JWT token lifetimes (Go duration strings)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Comma-separated list of allowed origins (required)
CORS_ALLOWED_ORIGINS=http://localhost:3000
