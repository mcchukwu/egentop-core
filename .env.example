APP_NAME=Egentop
APP_PORT=8080
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=egentop
DB_USER=user
DB_PASSWORD=password

DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

LOG_LEVEL=debug

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars

# JWT token lifetimes (Go duration strings)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# When true, accounts must have a verified email before changing passwords
REQUIRE_EMAIL_VERIFICATION=false

# Comma-separated list of allowed origins (required)
CORS_ALLOWED_ORIGINS=http://localhost:3000
